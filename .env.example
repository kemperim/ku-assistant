# ================================================================
#  RAG Abitur Agent — конфигурация
#  Скопируйте этот файл в .env и заполните свои значения
# ================================================================

# ── 1. GROQ API ──────────────────────────────────────────────────
# Получить ключ: https://console.groq.com → API Keys
GROQ_API_KEY=

# Модель Groq (рекомендуется оставить как есть)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2


# ── 2. GOOGLE DRIVE ──────────────────────────────────────────────
# Вставьте ID папок или файлов через запятую.
#
# Как получить ID:
#   Папка:  https://drive.google.com/drive/folders/[ЭТО_ID]
#   Файл:   https://drive.google.com/file/d/[ЭТО_ID]/view
#https://drive.google.com/drive/folders/121Bwfx2mO281kFQBdL8XB2N4ZQUNss5W?usp=sharing
# Для ПУБЛИЧНЫХ файлов/папок (доступ "Все у кого есть ссылка"):
GDRIVE_IDS=
# Для ПРИВАТНЫХ файлов через Service Account:
# 1. Создайте Service Account в Google Cloud Console
# 2. Выдайте ему доступ к нужным файлам/папкам на Drive
# 3. Скачайте JSON ключ и укажите путь ниже (или вставьте JSON строкой)
GDRIVE_SERVICE_ACCOUNT_JSON=


# ── 3. OLLAMA EMBEDDINGS ─────────────────────────────────────────
# URL Ollama (менять только если Ollama запущена отдельно)
OLLAMA_BASE_URL=http://ollama:11434

# Модель для эмбеддингов (nomic-embed-text — хороший выбор)
OLLAMA_EMBED_MODEL=nomic-embed-text


# ── 4. RAG ПАРАМЕТРЫ ─────────────────────────────────────────────
# Размер чанка (в символах) и перекрытие
CHUNK_SIZE=800
CHUNK_OVERLAP=100


# ── 5. ДОПОЛНИТЕЛЬНО ─────────────────────────────────────────────
# Автоматически синхронизировать Google Drive при старте
AUTO_SYNC_ON_START=true

# Заголовок интерфейса
APP_TITLE=Приёмная комиссия — ИИ-помощник
